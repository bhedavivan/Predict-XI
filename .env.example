# Soccer Predictor Environment Variables
# Copy this file to .env and fill in your values

# Football-Data.org API Token (get one free at https://www.football-data.org/client/register)
API_TOKEN=your_api_token_here

# Optional: Custom base URL (default: https://api.football-data.org/v4)
# BASE_URL=https://api.football-data.org/v4

# Optional: Default season (default: 2023)
# DEFAULT_SEASON=2023

# Optional: Default leagues to train on (comma-separated, default: all)
# DEFAULT_LEAGUES=PL,SA,BL1,PD,FL1

# Optional: Model path (default: model.json)
# MODEL_PATH=model.json

# Optional: Data cache path (default: matches_data.json)
# DATA_PATH=matches_data.json

# Optional: Flask settings (for web UI)
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# FLASK_DEBUG=False